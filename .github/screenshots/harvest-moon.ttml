    <p begin="00:01:09.000" end="00:01:12.000"><span begin="00:01:09.000" end="00:01:10.100">Outdoors</span> <span begin="00:01:10.100" end="00:01:10.570">and</span> <span begin="00:01:10.570" end="00:01:12.000">spoon.</span></p>
    <p begin="00:01:12.000" end="00:01:17.000"><span begin="00:01:12.000" end="00:01:12.340">So</span> <span begin="00:01:12.340" end="00:01:13.200">shine</span> <span begin="00:01:13.200" end="00:01:13.880">on,</span> <span begin="00:01:13.880" end="00:01:14.740">shine</span> <span begin="00:01:14.740" end="00:01:16.040">on,</span> <span begin="00:01:16.040" end="00:01:16.280">harvest</span> <span begin="00:01:16.280" end="00:01:17.000">moon,</span></p>
    <p begin="00:01:17.000" end="00:01:21.000"><span begin="00:01:17.000" end="00:01:17.750">For</span> <span begin="00:01:17.750" end="00:01:18.250">me</span> <span begin="00:01:18.250" end="00:01:19.000">and</span> <span begin="00:01:19.000" end="00:01:19.500">my</span> <span begin="00:01:19.500" end="00:01:21.000">gal.</span></p>
